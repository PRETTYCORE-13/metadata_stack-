# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez
*.env

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
metadata_app-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# BCs generados con el BPB (pty_*, demo100_*): son micro-apps que ADN arma
# localmente a partir del motor, no código de la plataforma. Nunca van a
# este repo, ni de prueba ni reales — se recrean con "mix gen.catalogos"
# a partir de meta_schema_* o se despliegan aparte a producción. Cada
# desarrollador genera su propio set local; commitearlos causa conflictos
# de versión entre máquinas que no tienen los mismos catálogos armados.
lib/metadata_app/meta_business_process/catalogos/pty_*.ex
lib/metadata_app/meta_business_process/catalogos/demo100_*.ex
lib/metadata_app/meta_business_process/reglas/pty_*/
lib/metadata_app/meta_business_process/reglas/demo100_*/
priv/repo/catalogos/pty_*.json
priv/repo/catalogos/demo100_*.json
priv/repo/migrations/*pty_*.exs
priv/repo/migrations/*demo100_*.exs

# Excepción real (2026-09-03): esta migración crea `pty_folio_perfiles`,
# la tabla que `folio_historial` (motor de Folios, siempre migrada, NO
# gitignorada) referencia con una FK dura -- sin comitearla, cualquier
# pipeline que migre desde una base vacía (CI, un servidor nuevo) revienta
# con "relation pty_folio_perfiles does not exist". A diferencia del resto
# de los catálogos pty_* (generados/publicados por su cuenta vía el Motor
# BC), esta tabla es dependencia dura de infraestructura core del motor,
# no un catálogo opcional -- necesita vivir siempre en el repo. Mismo
# motivo para las 2 migraciones de datos que registran pty_folio_perfiles
# y pty_subtipos_transaccion como catálogos reales (meta_schema_header/
# detail/estados/transiciones) -- normalmente eso lo arma `mix meta.import`
# desde un .meta.json, pero el de estos dos NUNCA se comiteó (ni siquiera
# existe localmente para pty_folio_perfiles) porque también cae bajo la
# convención pty_* de más arriba. Sin el registro, IdentificadoresTransaccionales
# (que sí es motor siempre-presente) no encuentra el catálogo
# (Ecto.NoResultsError) en un checkout limpio, aunque las tablas físicas
# ya existan.
!priv/repo/migrations/20260901201800_crear_pty_subtipos_transaccion.exs
!priv/repo/migrations/20260901201822_crear_pty_folio_perfiles_20260901201822.exs
!priv/repo/migrations/20260903000000_registrar_catalogo_pty_folio_perfiles.exs
!priv/repo/migrations/20260903000100_registrar_catalogo_pty_subtipos_transaccion.exs

# `mix gen.catalogos` (ver lib/mix/tasks/gen.catalogos.ex) decide si un
# catálogo YA está generado mirando si su archivo existe en este
# directorio -- no si la tabla ya existe en Postgres. Sin comitear estos
# dos .ex, un checkout limpio (donde la tabla YA existe por las
# migraciones de arriba) hace que gen.catalogos intente generarla de
# nuevo -- "la relación pty_folio_perfiles ya existe", encontrado real
# reproduciendo el fix completo en un checkout simulado. Contenido
# idéntico al que ya genera el motor -- nunca se edita a mano.
!lib/metadata_app/meta_business_process/catalogos/pty_folio_perfiles.ex
!lib/metadata_app/meta_business_process/catalogos/pty_subtipos_transaccion.ex

# Bundle temporal de MetaPublicador.armar_bundle/1 -- se arma en la raíz
# del proyecto (nombre relativo, para que tar nunca vea una ruta con
# letra de unidad en Windows) y se mueve al temp dir del sistema al
# toque. Esto es solo por si un crash justo en el medio deja uno tirado.
bc-bundle-*.tar.gz

priv/plts/

# Config local de desarrollo (puerto/credenciales de DB varían por máquina).
config/dev.exs
